# Copy to .env and fill in. The real .env is git-ignored because it holds a password.

SMTP_HOST=smtp.example.com
# 465 selects implicit TLS; anything else (587, 25) uses STARTTLS.
SMTP_PORT=465
# Also used as the From address: most providers reject a From that is not the login.
SMTP_MAIL=address@example.com
SMTP_PASSWORD=an-app-specific-password

# Mailbox that receives enrolment submissions, with the certificate photo attached.
ENROLLMENT_RECIPIENT=address@example.com

# Digits only, country code included, no "+" and no spaces (e.g. 393331234567).
# Optional: when empty, the last enrolment step shows a placeholder.
WHATSAPP_NUMBER=
